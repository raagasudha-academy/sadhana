{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProvisionStagePrefixedDynamoTablesOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:DescribeTable",
        "dynamodb:ListTagsOfResource",
        "dynamodb:TagResource",
        "dynamodb:UntagResource",
        "dynamodb:UpdateContinuousBackups",
        "dynamodb:UpdateTable"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:627821644317:table/prod-sadhana-*",
        "arn:aws:dynamodb:us-east-1:627821644317:table/prod-sruti-*",
        "arn:aws:dynamodb:us-east-1:627821644317:table/prod-raagasudha-student-registrations"
      ]
    },
    {
      "Sid": "ProvisionOnlyProductionSadhanaBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:GetBucketCors",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetBucketLocation",
        "s3:GetBucketOwnershipControls",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketTagging",
        "s3:GetBucketVersioning",
        "s3:ListBucket",
        "s3:PutBucketCors",
        "s3:PutEncryptionConfiguration",
        "s3:PutLifecycleConfiguration",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketTagging",
        "s3:PutBucketVersioning"
      ],
      "Resource": [
        "arn:aws:s3:::prod-sadhana-homework-media-627821644317-us-east-1",
        "arn:aws:s3:::prod-sadhana-profile-photos-627821644317-us-east-1"
      ]
    },
    {
      "Sid": "ReadOnlyDeploymentArtifacts",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::prod-sadhana-intake-deploy-627821644317-us-east-1/*"
    },
    {
      "Sid": "CreateAndConfigureOnlyProductionSadhanaLambdas",
      "Effect": "Allow",
      "Action": [
        "lambda:AddPermission",
        "lambda:CreateFunction",
        "lambda:DeleteFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetPolicy",
        "lambda:ListTags",
        "lambda:RemovePermission",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-1:627821644317:function:prod-sadhana-*",
        "arn:aws:lambda:us-east-1:627821644317:function:prod-sruti-public-intake"
      ]
    },
    {
      "Sid": "CreateLambdaRolesWithFixedBoundaries",
      "Effect": "Allow",
      "Action": ["iam:CreateRole"],
      "Resource": [
        "arn:aws:iam::627821644317:role/prod-sadhana-*",
        "arn:aws:iam::627821644317:role/prod-sruti-*"
      ],
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": [
            "arn:aws:iam::627821644317:policy/SadhanaProdLambdaBoundary",
            "arn:aws:iam::627821644317:policy/SrutiProdIntakeBoundary"
          ]
        }
      }
    },
    {
      "Sid": "ManageOnlyBoundedProductionLambdaRoles",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:GetRole",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:PutRolePolicy",
        "iam:PutRolePermissionsBoundary",
        "iam:UpdateAssumeRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::627821644317:role/prod-sadhana-*",
        "arn:aws:iam::627821644317:role/prod-sruti-*"
      ],
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": [
            "arn:aws:iam::627821644317:policy/SadhanaProdLambdaBoundary",
            "arn:aws:iam::627821644317:policy/SrutiProdIntakeBoundary"
          ]
        }
      }
    },
    {
      "Sid": "TagOnlyProductionLambdaRolesWithSadhanaTags",
      "Effect": "Allow",
      "Action": ["iam:TagRole"],
      "Resource": [
        "arn:aws:iam::627821644317:role/prod-sadhana-*",
        "arn:aws:iam::627821644317:role/prod-sruti-*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "Sadhana",
          "aws:RequestTag/Environment": "prod"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": ["Project", "Environment"]
        }
      }
    },
    {
      "Sid": "UntagOnlyProductionLambdaRoleProjectTags",
      "Effect": "Allow",
      "Action": ["iam:UntagRole"],
      "Resource": [
        "arn:aws:iam::627821644317:role/prod-sadhana-*",
        "arn:aws:iam::627821644317:role/prod-sruti-*"
      ],
      "Condition": {
        "ForAllValues:StringEquals": {
          "aws:TagKeys": ["Project", "Environment"]
        }
      }
    },
    {
      "Sid": "AttachOnlyLambdaBasicExecutionPolicy",
      "Effect": "Allow",
      "Action": ["iam:AttachRolePolicy", "iam:DetachRolePolicy"],
      "Resource": [
        "arn:aws:iam::627821644317:role/prod-sadhana-*",
        "arn:aws:iam::627821644317:role/prod-sruti-*"
      ],
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": [
            "arn:aws:iam::627821644317:policy/SadhanaProdLambdaBoundary",
            "arn:aws:iam::627821644317:policy/SrutiProdIntakeBoundary"
          ],
          "iam:PolicyARN": "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        }
      }
    },
    {
      "Sid": "PassOnlyBoundedRolesToLambda",
      "Effect": "Allow",
      "Action": ["iam:PassRole"],
      "Resource": [
        "arn:aws:iam::627821644317:role/prod-sadhana-*",
        "arn:aws:iam::627821644317:role/prod-sruti-*"
      ],
      "Condition": {
        "StringEquals": { "iam:PassedToService": "lambda.amazonaws.com" }
      }
    },
    {
      "Sid": "ManageOnlyProductionSadhanaLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:DeleteRetentionPolicy",
        "logs:DescribeLogGroups",
        "logs:PutRetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:627821644317:log-group:/aws/lambda/prod-sadhana-*",
        "arn:aws:logs:us-east-1:627821644317:log-group:/aws/lambda/prod-sadhana-*:*",
        "arn:aws:logs:us-east-1:627821644317:log-group:/aws/lambda/prod-sruti-public-intake*",
        "arn:aws:logs:us-east-1:627821644317:log-group:/aws/lambda/prod-sruti-public-intake*:*"
      ]
    },
    {
      "Sid": "ManageRegionalSadhanaApiGatewayResources",
      "Effect": "Allow",
      "Action": [
        "apigateway:DELETE",
        "apigateway:GET",
        "apigateway:PATCH",
        "apigateway:POST",
        "apigateway:PUT"
      ],
      "Resource": [
        "arn:aws:apigateway:us-east-1::/apis",
        "arn:aws:apigateway:us-east-1::/apis/*",
        "arn:aws:apigateway:us-east-1::/restapis",
        "arn:aws:apigateway:us-east-1::/restapis/*"
      ]
    },
    {
      "Sid": "CreateTaggedProductionSrutiWebAcl",
      "Effect": "Allow",
      "Action": ["wafv2:CreateWebACL"],
      "Resource": "arn:aws:wafv2:us-east-1:627821644317:regional/webacl/prod-sadhana-sruti-intake-waf/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "Sadhana",
          "aws:RequestTag/Environment": "prod"
        }
      }
    },
    {
      "Sid": "UseOnlyRegionalManagedRuleSetsForProductionSrutiAcl",
      "Effect": "Allow",
      "Action": ["wafv2:CreateWebACL"],
      "Resource": "arn:aws:wafv2:us-east-1:627821644317:regional/managedruleset/*/*"
    },
    {
      "Sid": "ManageProductionSrutiWebAcl",
      "Effect": "Allow",
      "Action": [
        "wafv2:AssociateWebACL",
        "wafv2:DeleteWebACL",
        "wafv2:DisassociateWebACL",
        "wafv2:GetWebACL",
        "wafv2:ListTagsForResource",
        "wafv2:TagResource",
        "wafv2:UntagResource",
        "wafv2:UpdateWebACL"
      ],
      "Resource": [
        "arn:aws:wafv2:us-east-1:627821644317:regional/webacl/prod-sadhana-sruti-intake-waf/*",
        "arn:aws:apigateway:us-east-1::/restapis/*/stages/*"
      ]
    },
    {
      "Sid": "AssociateWebAclOnlyWithProductionApiStages",
      "Effect": "Allow",
      "Action": ["apigateway:SetWebACL"],
      "Resource": "arn:aws:apigateway:us-east-1::/restapis/*/stages/prod"
    },
    {
      "Sid": "TagOnlySamHttpApiMarker",
      "Effect": "Allow",
      "Action": ["apigateway:PUT"],
      "Resource": "arn:aws:apigateway:us-east-1::/tags/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/httpapi:createdBy": "SAM"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": ["httpapi:createdBy"]
        }
      }
    },
    {
      "Sid": "TagOnlySamHttpApiStageCollections",
      "Effect": "Allow",
      "Action": ["apigateway:PATCH", "apigateway:POST", "apigateway:PUT", "apigateway:TagResource"],
      "Resource": "arn:aws:apigateway:us-east-1::/apis/*/stages",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/aws:cloudformation:stack-name": "prod-sadhana-app",
          "aws:RequestTag/aws:cloudformation:logical-id": "SadhanaApiStage",
          "aws:RequestTag/httpapi:createdBy": "SAM",
          "aws:RequestedRegion": "us-east-1"
        },
        "StringLike": {
          "aws:RequestTag/aws:cloudformation:stack-id": "arn:aws:cloudformation:us-east-1:627821644317:stack/prod-sadhana-app/*"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "aws:cloudformation:stack-name",
            "aws:cloudformation:stack-id",
            "aws:cloudformation:logical-id",
            "httpapi:createdBy"
          ]
        }
      }
    },
    {
      "Sid": "ReadProductionSrutiWebAclAssociation",
      "Effect": "Allow",
      "Action": ["wafv2:GetWebACLForResource"],
      "Resource": "arn:aws:wafv2:us-east-1:627821644317:regional/webacl/*/*"
    },
    {
      "Sid": "AllowOnlyTheSAMTransformForProductionChangesets",
      "Effect": "Allow",
      "Action": ["cloudformation:CreateChangeSet"],
      "Resource": "arn:aws:cloudformation:us-east-1:aws:transform/Serverless-2016-10-31"
    }
  ]
}
