{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UpdateOnlyProductionSadhanaCognitoPool",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:DescribeUserPool",
        "cognito-idp:DescribeUserPoolClient",
        "cognito-idp:GetUserPoolMfaConfig",
        "cognito-idp:SetUserPoolMfaConfig",
        "cognito-idp:UpdateUserPool",
        "cognito-idp:UpdateUserPoolClient"
      ],
      "Resource": "arn:aws:cognito-idp:us-east-1:627821644317:userpool/us-east-1_Egro1CA39"
    },
    {
      "Sid": "InspectAndDetachOnlyProductionCognitoInvitationRole",
      "Effect": "Allow",
      "Action": ["iam:DetachRolePolicy", "iam:GetRole", "iam:ListAttachedRolePolicies"],
      "Resource": "arn:aws:iam::627821644317:role/prod-sadhana-cognito-invitation-role"
    }
  ]
}
