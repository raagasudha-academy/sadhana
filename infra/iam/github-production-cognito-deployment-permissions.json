{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeployOnlyTheExistingProductionCognitoStack",
      "Effect": "Allow",
      "Action": ["cloudformation:CreateChangeSet", "cloudformation:UpdateStack"],
      "Resource": "arn:aws:cloudformation:us-east-1:627821644317:stack/sadhana-prod-cognito/*",
      "Condition": {
        "ArnEquals": {
          "cloudformation:RoleArn": "arn:aws:iam::627821644317:role/prod-sadhana-cloudformation-execution"
        }
      }
    },
    {
      "Sid": "InspectAndExecuteOnlyProductionCognitoChangesets",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DeleteChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:GetTemplate",
        "cloudformation:GetTemplateSummary",
        "cloudformation:ListStackResources",
        "cloudformation:TagResource",
        "cloudformation:UntagResource"
      ],
      "Resource": "arn:aws:cloudformation:us-east-1:627821644317:stack/sadhana-prod-cognito/*"
    },
    {
      "Sid": "ReadOnlyProductionCognitoStackStatus",
      "Effect": "Allow",
      "Action": ["cloudformation:DescribeStacks"],
      "Resource": "arn:aws:cloudformation:us-east-1:627821644317:stack/sadhana-prod-cognito/*"
    }
  ]
}
