{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteIntakeLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:627821644317:log-group:/aws/lambda/prod-sruti-public-intake:*"
    },
    {
      "Sid": "WriteOnlyToProductionSrutiIntake",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem"],
      "Resource": "arn:aws:dynamodb:us-east-1:627821644317:table/prod-sruti-student-registrations"
    }
  ]
}
