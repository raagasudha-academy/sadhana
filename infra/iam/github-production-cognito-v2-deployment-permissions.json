{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateOrUpdateOnlyTheProductionCognitoV2Stack",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateStack",
        "cloudformation:UpdateStack",
        "cloudformation:CreateChangeSet"
      ],
      "Resource": "arn:aws:cloudformation:us-east-1:627821644317:stack/sadhana-prod-cognito-v2/*",
      "Condition": {
        "ArnEquals": {
          "cloudformation:RoleArn": "arn:aws:iam::627821644317:role/prod-sadhana-cloudformation-execution"
        }
      }
    },
    {
      "Sid": "InspectAndExecuteOnlyTheProductionCognitoV2Stack",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DeleteChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:GetTemplate",
        "cloudformation:GetTemplateSummary",
        "cloudformation:ListStackResources",
        "cloudformation:TagResource",
        "cloudformation:UntagResource"
      ],
      "Resource": "arn:aws:cloudformation:us-east-1:627821644317:stack/sadhana-prod-cognito-v2/*"
    },
    {
      "Sid": "ReadOnlyProductionCognitoV2StackStatus",
      "Effect": "Allow",
      "Action": ["cloudformation:DescribeStacks"],
      "Resource": "arn:aws:cloudformation:us-east-1:627821644317:stack/sadhana-prod-cognito-v2/*"
    },
    {
      "Sid": "UseOnlyTheSadhanaCloudFormationExecutionRole",
      "Effect": "Allow",
      "Action": ["iam:PassRole"],
      "Resource": "arn:aws:iam::627821644317:role/prod-sadhana-cloudformation-execution",
      "Condition": {
        "StringEquals": { "iam:PassedToService": "cloudformation.amazonaws.com" }
      }
    },
    {
      "Sid": "AllowOnlyTheSAMTransformForV2Changesets",
      "Effect": "Allow",
      "Action": ["cloudformation:CreateChangeSet"],
      "Resource": "arn:aws:cloudformation:us-east-1:aws:transform/Serverless-2016-10-31"
    },
    {
      "Sid": "ReadOnlyTaggedProductionV2UserPool",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:DescribeUserPool",
        "cognito-idp:DescribeUserPoolClient",
        "cognito-idp:ListGroups"
      ],
      "Resource": "arn:aws:cognito-idp:us-east-1:627821644317:userpool/*",
      "Condition": {
        "StringEquals": { "aws:ResourceTag/Generation": "v2" }
      }
    },
    {
      "Sid": "ReadCognitoDomainStatus",
      "Effect": "Allow",
      "Action": ["cognito-idp:DescribeUserPoolDomain"],
      "Resource": "*"
    }
  ]
}
